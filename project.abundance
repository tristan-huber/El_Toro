              "topLevel": false,
              "allAtoms": [
                {
                  "atomType": "Output",
                  "x": 1,
                  "y": 0.5,
                  "uniqueID": "id-42877",
                  "ioValues": [
                    {
                      "name": "number or geometry",
                      "ioValue": "__GEOMETRY_INPUT__"
                    }
                  ]
                },
                {
                  "atomType": "Code",
                  "x": 0.5,
                  "y": 0.2,
                  "uniqueID": "id-42878",
                  "ioValues": [
                    {
                      "name": "toRotate",
                      "ioValue": "__GEOMETRY_INPUT__"
                    },
                    {
                      "name": "pivotPoint",
                      "ioValue": [
                        "5",
                        "-7.5"
                      ]
                    },
                    {
                      "name": "x",
                      "ioValue": 0
