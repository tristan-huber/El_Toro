                  "topLevel": false,
                  "allAtoms": [
                    {
                      "atomType": "Output",
                      "x": 1,
                      "y": 0.5,
                      "uniqueID": "id-37023",
                      "ioValues": [
                        {
                          "name": "number or geometry",
