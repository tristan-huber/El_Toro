n      wireList.push(leaf.geometry)\n    }\n    return leaf;\n  })\n\n  const surfaces = [];\n  const startpoints = [];\n  const endpoints = [];\n  for (let i = 0; i < wireList.length; i++) {\n    const endindex = (i + 2) % wireList.length\n    console.log(`${i} to ${endindex}`)\n    const surf = replicad.loft([wireList[i], wireList[endindex]], {}, true)\n    surfaces.push(surf)\n    startpoints.push(wireList[i].startPoint)\n    endpoints.push(wireList[i].endPoint)\n  }\n  \n  return replicad.makeSolid(surfaces)\n}\n",
