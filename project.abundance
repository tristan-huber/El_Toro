          "code": "\n/**\n * This code atom implements a simple linear layout funtion which repeats\n * shape count times in the positive X direction with offset space\n * between each. Works for either 2D or 3D shapes. Negative offset\n * and negative counts invert the direction.\n * \n * Notice that defaults are set for both count and offset.\n */\nfunction run(interval: number, offsets: number[]) {\n  const points: [number, number, number][] = []\n  let x = 0;\n  offsets.forEach((offset) => {\n    points.push([x, offset, 0])\n    x += interval\n  })\n\n  return replicad.assembleWire([replicad.makeBSplineApproximation(points, {\n    degMax: 3,\n    degMin: 3,\n    tolerance: 0.0001,\n  })])\n\n}",
          "compiledCode": "\"use strict\";\n/**\n * This code atom implements a simple linear layout funtion which repeats\n * shape count times in the positive X direction with offset space\n * between each. Works for either 2D or 3D shapes. Negative offset\n * and negative counts invert the direction.\n *\n * Notice that defaults are set for both count and offset.\n */\nfunction run(interval, offsets) {\n    const points = [];\n    let x = 0;\n    offsets.forEach((offset) => {\n        points.push([x, offset, 0]);\n        x += interval;\n    });\n    return replicad.assembleWire([replicad.makeBSplineApproximation(points, {\n            degMax: 3,\n            degMin: 3,\n            tolerance: 0.0001,\n        })]);\n}\n"
