            {
              "atomType": "Code",
              "x": 0.4296875,
              "y": 0.6514285714285714,
              "uniqueID": "id-5579",
              "ioValues": [
                {
                  "name": "points",
                  "ioValue": "__GEOMETRY_INPUT__"
