                {
                  "atomType": "Code",
                  "x": 0.6,
                  "y": 0.4,
                  "uniqueID": "id-34954",
                  "ioValues": [
                    {
                      "name": "A",
                      "ioValue": "__GEOMETRY_INPUT__"
