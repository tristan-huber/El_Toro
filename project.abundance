            },
            {
              "atomType": "Code",
              "x": 0.5,
              "y": 0.3,
              "uniqueID": "id-28172",
              "ioValues": [
                {
                  "name": "surface",
                  "ioValue": "__GEOMETRY_INPUT__"
                },
                {
                  "name": "numRulings",
                  "ioValue": 200
                },
                {
                  "name": "rulingAxis",
                  "ioValue": "auto",
                  "currentEquation": "auto"
                },
                {
                  "name": "seamAtStart",
                  "ioValue": true
