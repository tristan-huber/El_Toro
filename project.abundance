            {
              "atomType": "Code",
              "x": 0.5130208333333334,
              "y": 0.5773809523809523,
              "uniqueID": "id-28159",
              "ioValues": [
                {
                  "name": "surface",
                  "ioValue": "__GEOMETRY_INPUT__"
                },
                {
