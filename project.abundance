    {
      "atomType": "GitHubMolecule",
      "x": 0.49169921875,
      "y": 0.25416666666666665,
      "uniqueID": "id-24523",
      "name": "crv.Unroll",
      "ioValues": [
        {
          "name": "Face",
          "ioValue": "__GEOMETRY_INPUT__"
        },
        {
          "name": "NumRulings",
          "ioValue": 60
        },
