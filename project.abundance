            "searchField": "crv.rulinglines tristan-huber extract ruling lines from a surface, typically for use with lofted surfaces. takes a single face as input. abundance-tool",
            "owner": "tristan-huber",
            "description": "Extract Ruling lines from a surface, typically for use with lofted surfaces. Takes a single Face as input.",
            "contentURL": "https://raw.githubusercontent.com/tristan-huber/crv.RulingLines/master/project.abundance?sanitize=true",
            "svgURL": "https://raw.githubusercontent.com/tristan-huber/crv.RulingLines/master/project.svg?sanitize=true",
