          "topLevel": false,
          "allAtoms": [
            {
              "atomType": "Output",
              "x": 0.98,
              "y": 0.5,
              "uniqueID": "id-28171",
              "ioValues": [
                {
                  "name": "number or geometry",
                  "ioValue": "__GEOMETRY_INPUT__"
                }
              ]
            },
            {
              "atomType": "Code",
              "x": 0.5455729166666666,
              "y": 0.32440476190476186,
              "uniqueID": "id-28172",
              "ioValues": [
                {
                  "name": "surface",
                  "ioValue": "__GEOMETRY_INPUT__"
                },
                {
                  "name": "numRulings",
                  "ioValue": 200
                },
                {
                  "name": "rulingAxis",
                  "ioValue": "auto",
                  "currentEquation": "auto"
                },
                {
                  "name": "seamAtStart",
                  "ioValue": true
                },
                {
                  "name": "boundarySamples",
                  "ioValue": 256
                },
                {
                  "name": "holeSamples",
                  "ioValue": 64
