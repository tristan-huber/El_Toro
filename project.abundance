        {
          "atomType": "GitHubMolecule",
          "x": 0.3033854166666667,
          "y": 0.3485714285714286,
          "uniqueID": "id-7542",
          "name": "crv.OpenWireLoft",
          "ioValues": [
            {
              "name": "Wires",
              "ioValue": "__GEOMETRY_INPUT__"
            },
            {
              "name": "Thickness",
