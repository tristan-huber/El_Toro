              "interpreterVersion": 1,
              "code": "/**\n * Extracts the ruling lines from a ruled surface.\n *\n * Input must be an Assembly containing a single replicad.Face — typically the\n * side face of a ruled loft. The atom samples `numRulings + 1` straight-line\n * generators across the surface and returns them as 3D wires for visual\n * confirmation. A downstream \"Develop\" atom will reuse this sampling to flatten\n * the surface into a 2D pattern.\n *\n *   rulingAxis === \"U\"  → each ruling sweeps U from uMin..uMax with V fixed;\n *                          rulings step in V.\n *   rulingAxis === \"V\"  → each ruling sweeps V from vMin..vMax with U fixed;\n *                          rulings step in U.\n *   rulingAxis === \"auto\" → pick the parametric axis whose interior iso-curves\n *                          are (within tolerance) straight lines. Ties prefer V\n *                          to match replicad's `ruled: true` loft convention.\n */\nfunction run(\n  surface: Assembly,\n  numRulings: number = 24,\n  rulingAxis: string = \"auto\",\n): Assembly {\n  // ── Step 1: Validate input is a single Face ───────────────────────────────\n  if (!surface || !surface.isLeaf || !surface.isLeaf()) {\n    throw new Error(\n      \"Develop rulings: input must be an Assembly with exactly one leaf \" +\n      \"(the ruled surface as a replicad.Face).\",\n    );\n  }\n  const face = surface.geometry as any;\n  if (!(face instanceof replicad.Face)) {\n    throw new Error(\n      \"Develop rulings: input geometry must be a replicad.Face from a ruled \" +\n      \"loft; got \" +\n      (face && face.constructor ? face.constructor.name : typeof face),\n    );\n  }\n  if (!Number.isFinite(numRulings) || numRulings < 1) {\n    throw new Error(\"Develop rulings: numRulings must be a positive integer.\");\n  }\n  const n = Math.max(1, Math.floor(numRulings));\n\n  const { uMin, uMax, vMin, vMax } = face.UVBounds;\n\n  // pointOnSurface returns a replicad.Vector; wrap into a plain tuple for math\n  // and a Point for makeLine().\n  const sampleTuple = (u: number, v: number): [number, number, number] => {\n    const p = face.pointOnSurface(u, v);\n    return [p.x, p.y, p.z];\n  };\n\n  // ── Step 2: Decide which parametric axis is the ruling direction ──────────\n  // An iso-curve sample at parameters (p0, pm, p1) is \"straight\" when the\n  // perpendicular distance from the midpoint to the chord is negligible\n  // relative to the chord length.\n  const STRAIGHT_TOL = 1e-4;\n  const isStraightAlong = (axis: \"U\" | \"V\"): boolean => {\n    const cross =\n      axis === \"U\" ? vMin + 0.5 * (vMax - vMin) : uMin + 0.5 * (uMax - uMin);\n    const a = axis === \"U\" ? uMin : vMin;\n    const b = axis === \"U\" ? uMax : vMax;\n    const get = (t: number) =>\n      axis === \"U\" ? sampleTuple(t, cross) : sampleTuple(cross, t);\n    const p0 = get(a);\n    const pm = get(0.5 * (a + b));\n    const p1 = get(b);\n    const dx = p1[0] - p0[0],\n      dy = p1[1] - p0[1],\n      dz = p1[2] - p0[2];\n    const chord = Math.hypot(dx, dy, dz);\n    if (chord === 0) return false;\n    const tx = pm[0] - p0[0],\n      ty = pm[1] - p0[1],\n      tz = pm[2] - p0[2];\n    // |(p1-p0) × (pm-p0)| / |p1-p0| = perpendicular distance.\n    const cx = dy * tz - dz * ty;\n    const cy = dz * tx - dx * tz;\n    const cz = dx * ty - dy * tx;\n    const perp = Math.hypot(cx, cy, cz) / chord;\n    return perp / chord < STRAIGHT_TOL;\n  };\n\n  let axis: \"U\" | \"V\";\n  if (rulingAxis === \"U\" || rulingAxis === \"V\") {\n    axis = rulingAxis;\n  } else if (rulingAxis === \"auto\") {\n    const vStraight = isStraightAlong(\"V\");\n    const uStraight = isStraightAlong(\"U\");\n    if (vStraight) axis = \"V\";\n    else if (uStraight) axis = \"U\";\n    else\n      throw new Error(\n        \"Develop rulings: auto-detect failed — surface is not straight along \" +\n        \"either parametric axis (it is not a ruled surface, or the trimmed \" +\n        \"region is curved on both axes). Override with rulingAxis: 'U' or 'V'.\",\n      );\n  } else {\n    throw new Error(\n      'Develop rulings: rulingAxis must be \"auto\", \"U\", or \"V\"; got ' +\n      JSON.stringify(rulingAxis),\n    );\n  }\n\n  // ── Step 3: Build n+1 ruling edges along the chosen axis ──────────────────\n  // axis === \"V\": rulings run vMin → vMax; we step the OTHER parameter (U).\n  // axis === \"U\": rulings run uMin → uMax; we step the OTHER parameter (V).\n  const rulings: Assembly[] = [];\n  for (let i = 0; i <= n; i++) {\n    const t = i / n;\n    let pStart: any, pEnd: any;\n    if (axis === \"V\") {\n      const u = uMin + t * (uMax - uMin);\n      pStart = face.pointOnSurface(u, vMin);\n      pEnd = face.pointOnSurface(u, vMax);\n    } else {\n      const v = vMin + t * (vMax - vMin);\n      pStart = face.pointOnSurface(uMin, v);\n      pEnd = face.pointOnSurface(uMax, v);\n    }\n    const edge = replicad.makeLine(\n      [pStart.x, pStart.y, pStart.z],\n      [pEnd.x, pEnd.y, pEnd.z],\n    );\n    // The framework rejects bare Edges (see code.ts); wrap with assembleWire\n    // so each ruling round-trips as a Wire leaf.\n    const wire = replicad.assembleWire([edge]);\n    rulings.push(\n      new Assembly({\n        geometry: wire,\n        color: \"#e07b00\",\n        tags: [\"ruling\"],\n      }),\n    );\n  }\n\n  return new Assembly({\n    geometry: rulings,\n    color: \"#e07b00\",\n    tags: [\"rulings\", \"ruling-axis:\" + axis],\n  });\n}\n",
              "compiledCode": "\"use strict\";\n/**\n * Extracts the ruling lines from a ruled surface.\n *\n * Input must be an Assembly containing a single replicad.Face — typically the\n * side face of a ruled loft. The atom samples `numRulings + 1` straight-line\n * generators across the surface and returns them as 3D wires for visual\n * confirmation. A downstream \"Develop\" atom will reuse this sampling to flatten\n * the surface into a 2D pattern.\n *\n *   rulingAxis === \"U\"  → each ruling sweeps U from uMin..uMax with V fixed;\n *                          rulings step in V.\n *   rulingAxis === \"V\"  → each ruling sweeps V from vMin..vMax with U fixed;\n *                          rulings step in U.\n *   rulingAxis === \"auto\" → pick the parametric axis whose interior iso-curves\n *                          are (within tolerance) straight lines. Ties prefer V\n *                          to match replicad's `ruled: true` loft convention.\n */\nfunction run(surface, numRulings = 24, rulingAxis = \"auto\") {\n    // ── Step 1: Validate input is a single Face ───────────────────────────────\n    if (!surface || !surface.isLeaf || !surface.isLeaf()) {\n        throw new Error(\"Develop rulings: input must be an Assembly with exactly one leaf \" +\n            \"(the ruled surface as a replicad.Face).\");\n    }\n    const face = surface.geometry;\n    if (!(face instanceof replicad.Face)) {\n        throw new Error(\"Develop rulings: input geometry must be a replicad.Face from a ruled \" +\n            \"loft; got \" +\n            (face && face.constructor ? face.constructor.name : typeof face));\n    }\n    if (!Number.isFinite(numRulings) || numRulings < 1) {\n        throw new Error(\"Develop rulings: numRulings must be a positive integer.\");\n    }\n    const n = Math.max(1, Math.floor(numRulings));\n    const { uMin, uMax, vMin, vMax } = face.UVBounds;\n    // pointOnSurface returns a replicad.Vector; wrap into a plain tuple for math\n    // and a Point for makeLine().\n    const sampleTuple = (u, v) => {\n        const p = face.pointOnSurface(u, v);\n        return [p.x, p.y, p.z];\n    };\n    // ── Step 2: Decide which parametric axis is the ruling direction ──────────\n    // An iso-curve sample at parameters (p0, pm, p1) is \"straight\" when the\n    // perpendicular distance from the midpoint to the chord is negligible\n    // relative to the chord length.\n    const STRAIGHT_TOL = 1e-4;\n    const isStraightAlong = (axis) => {\n        const cross = axis === \"U\" ? vMin + 0.5 * (vMax - vMin) : uMin + 0.5 * (uMax - uMin);\n        const a = axis === \"U\" ? uMin : vMin;\n        const b = axis === \"U\" ? uMax : vMax;\n        const get = (t) => axis === \"U\" ? sampleTuple(t, cross) : sampleTuple(cross, t);\n        const p0 = get(a);\n        const pm = get(0.5 * (a + b));\n        const p1 = get(b);\n        const dx = p1[0] - p0[0], dy = p1[1] - p0[1], dz = p1[2] - p0[2];\n        const chord = Math.hypot(dx, dy, dz);\n        if (chord === 0)\n            return false;\n        const tx = pm[0] - p0[0], ty = pm[1] - p0[1], tz = pm[2] - p0[2];\n        // |(p1-p0) × (pm-p0)| / |p1-p0| = perpendicular distance.\n        const cx = dy * tz - dz * ty;\n        const cy = dz * tx - dx * tz;\n        const cz = dx * ty - dy * tx;\n        const perp = Math.hypot(cx, cy, cz) / chord;\n        return perp / chord < STRAIGHT_TOL;\n    };\n    let axis;\n    if (rulingAxis === \"U\" || rulingAxis === \"V\") {\n        axis = rulingAxis;\n    }\n    else if (rulingAxis === \"auto\") {\n        const vStraight = isStraightAlong(\"V\");\n        const uStraight = isStraightAlong(\"U\");\n        if (vStraight)\n            axis = \"V\";\n        else if (uStraight)\n            axis = \"U\";\n        else\n            throw new Error(\"Develop rulings: auto-detect failed — surface is not straight along \" +\n                \"either parametric axis (it is not a ruled surface, or the trimmed \" +\n                \"region is curved on both axes). Override with rulingAxis: 'U' or 'V'.\");\n    }\n    else {\n        throw new Error('Develop rulings: rulingAxis must be \"auto\", \"U\", or \"V\"; got ' +\n            JSON.stringify(rulingAxis));\n    }\n    // ── Step 3: Build n+1 ruling edges along the chosen axis ──────────────────\n    // axis === \"V\": rulings run vMin → vMax; we step the OTHER parameter (U).\n    // axis === \"U\": rulings run uMin → uMax; we step the OTHER parameter (V).\n    const rulings = [];\n    for (let i = 0; i <= n; i++) {\n        const t = i / n;\n        let pStart, pEnd;\n        if (axis === \"V\") {\n            const u = uMin + t * (uMax - uMin);\n            pStart = face.pointOnSurface(u, vMin);\n            pEnd = face.pointOnSurface(u, vMax);\n        }\n        else {\n            const v = vMin + t * (vMax - vMin);\n            pStart = face.pointOnSurface(uMin, v);\n            pEnd = face.pointOnSurface(uMax, v);\n        }\n        const edge = replicad.makeLine([pStart.x, pStart.y, pStart.z], [pEnd.x, pEnd.y, pEnd.z]);\n        // The framework rejects bare Edges (see code.ts); wrap with assembleWire\n        // so each ruling round-trips as a Wire leaf.\n        const wire = replicad.assembleWire([edge]);\n        rulings.push(new Assembly({\n            geometry: wire,\n            color: \"#e07b00\",\n            tags: [\"ruling\"],\n        }));\n    }\n    return new Assembly({\n        geometry: rulings,\n        color: \"#e07b00\",\n        tags: [\"rulings\", \"ruling-axis:\" + axis],\n    });\n}\n"
            },
