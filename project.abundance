        {
          "atomType": "Code",
          "x": 0.5546875,
          "y": 0.5916666666666667,
          "uniqueID": "id-24555",
          "ioValues": [
            {
              "name": "surface",
              "ioValue": "__GEOMETRY_INPUT__"
            },
            {
              "name": "numRulings",
              "ioValue": 50
            },
            {
              "name": "rulingAxis",
              "ioValue": "auto",
              "currentEquation": "auto"
            },
            {
              "name": "seamAtStart",
              "ioValue": true
            },
            {
              "name": "boundarySamples",
              "ioValue": 256
            },
            {
              "name": "holeSamples",
              "ioValue": 64
