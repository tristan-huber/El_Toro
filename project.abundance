                "ranking": 1.8,
                "searchField": "crv.polymove tristan-huber move one thing n times and return an assembly of the results. or move n things by n different distances. default direction is x+ abundance-tool",
                "owner": "tristan-huber",
                "description": "Move one thing n times and return an assembly of the results. Or move n things by n different distances. Default direction is X+",
                "contentURL": "https://raw.githubusercontent.com/tristan-huber/crv.PolyMove/master/project.abundance?sanitize=true",
                "svgURL": "https://raw.githubusercontent.com/tristan-huber/crv.PolyMove/master/project.svg?sanitize=true",
                "isLocal": false
